# ==============================================================================
# OrderHub Environment Configuration Template (.env.example)
# Note: Variable NAMES only. Do NOT commit real secrets or credentials.
# Environment values are managed directly via GitHub Environments (uat / production).
# ==============================================================================

# Application Environment (uat | production)
APP_ENV=uat

# Multi-Container Ports
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Base URLs used for health checks, smoke tests, and E2E journeys
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# CI/CD Notifications Webhook (GitHub Secret)
SLACK_WEBHOOK_URL=

# Deployment Configuration (Target Infrastructure / On-Prem VM)
DEPLOY_HOST=
DEPLOY_USER=appuser
SSH_KEY_PATH=
